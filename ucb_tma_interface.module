<?php

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Routing\RouteMatchInterface;

use Drupal\ucb_tma_interface\InterfaceController\TmaFrontController;
use Drupal\Component\Serialization\Json;

/**
 * Implements hook_webform_element_alter().
 */
function ucb_tma_interface_webform_element_alter(array &$element, \Drupal\Core\Form\FormStateInterface $form_state, array $context) {
    if(array_key_exists("#webform_id", $element)) {
		if ($element['#webform_id'] === 'report_a_problem--building' || $element['#webform_id'] === 'request_services--building') {
			if (isset($element['#default_value']) && strlen($element['#default_value'])) {
				$building_name = $element['#default_value'];
				// Prefer the Platform-backed location routes, not legacy /rest/* endpoints.
				// Select facility id from building taxonomy.
				$query = \Drupal::database()->select('taxonomy_term_field_data', 'fn');
				$query->addField('fi', 'field_tma_facility_id_value');
				$query->join('taxonomy_term__field_tma_facility_id', 'fi', 'fn.tid = fi.entity_id');
				$query->condition('fn.name', $building_name);
				$facility_id = $query->execute()->fetchField();
				$facility_id = is_numeric($facility_id) ? (int) $facility_id : 0;
				if ($facility_id > 0) {
					try {
						$builder = \Drupal::service('ucb_tma_interface.location_feed_payload');
						$buildings = is_object($builder) && method_exists($builder, 'getFeedItems') ? $builder->getFeedItems('Building', NULL) : [];
						$new_options = [];
						if (is_array($buildings)) {
							foreach ($buildings as $b) {
								if (!is_array($b)) {
									continue;
								}
								// connector is facility id.
								if ((int) ($b['connector'] ?? 0) !== $facility_id) {
									continue;
								}
								$name = $b['name'] ?? NULL;
								if (is_string($name) && $name !== '') {
									$new_options[$name] = $name;
								}
							}
						}
						if (!empty($new_options)) {
							$element['#options'] = $new_options;
						}
					}
					catch (\Throwable $e) {
						if (\Drupal::config('ucb_tma_interface.settings')->get('debug_api_logging')) {
							\Drupal::logger('ucb_tma_interface')->notice('Dropdown buildings build exception: @msg', ['@msg' => $e->getMessage()]);
						}
					}
				}
			}
			$element['#validated'] = TRUE;
        } else if ($element['#webform_id'] === 'report_a_problem--area' || $element['#webform_id'] === 'request_services--area') {
			if (isset($element['#default_value']) && strlen($element['#default_value'])) {
				$area_name = $element['#default_value']; // 19 for Darley South
				// select building id from area taxonomy
				$query = \Drupal::database()->select('taxonomy_term_field_data', 'bn');
				$query->addField('bi', 'field_tma_building_id__value');
				$query->join('taxonomy_term__field_tma_building_id_', 'bi', 'bn.tid = bi.entity_id');
				$query->condition('bn.name', $area_name);
				$building_id = $query->execute()->fetchField();
				$building_id = is_numeric($building_id) ? (int) $building_id : 0;
				if ($building_id > 0) {
					try {
						$builder = \Drupal::service('ucb_tma_interface.location_feed_payload');
						$areas = is_object($builder) && method_exists($builder, 'getFeedItems') ? $builder->getFeedItems('Area', NULL) : [];
						$new_options=array();
						if (is_array($areas)) {
							foreach($areas as $a) {
								if (!is_array($a)) {
									continue;
								}
								// connector is building id.
								if ((int) ($a['connector'] ?? 0) !== $building_id) {
									continue;
								}
								$name = $a['name'] ?? NULL;
								if (!is_string($name) || $name === '') {
									continue;
								}
								$desc = trim((string) ($a['description'] ?? ''));
								$new_options[$name] = $desc !== '' ? ($name . ', ' . $desc) : $name;
							}
						}
						if (!empty($new_options)) {
							$element['#options'] = $new_options;
						}
					}
					catch (\Throwable $e) {
						if (\Drupal::config('ucb_tma_interface.settings')->get('debug_api_logging')) {
							\Drupal::logger('ucb_tma_interface')->notice('Dropdown areas build exception: @msg', ['@msg' => $e->getMessage()]);
						}
					}
				}
			}
			$element['#validated'] = TRUE;
//        } elseif ($element['#webform_id'] === 'report_a_problem--facility') {
//			ksm($element);
        } elseif ($element['#webform_id'] === 'report_a_problem--faq'  || $element['#webform_id'] === 'request_services--faq') {
            // In webform YAML this markup is a token string like:
            //   [webform_submission:values:categories:entity:tid]
            // It is NOT guaranteed to be numeric at element-alter time, so we derive the tid from
            // the current submission when available.
            $tid = NULL;
            if (isset($element['#markup']) && is_numeric($element['#markup']) && $element['#markup'] * 1 == $element['#markup']) {
				$tid = (int) $element['#markup'];
            }
            if (!$tid && isset($context['webform_submission']) && $context['webform_submission'] instanceof \Drupal\webform\WebformSubmissionInterface) {
                $cats = $context['webform_submission']->getElementData('categories');
                if (is_numeric($cats)) {
                    $tid = (int) $cats;
                }
                elseif (is_array($cats)) {
                    // Some webforms store taxonomy references as arrays (take first).
                    $first = reset($cats);
                    if (is_numeric($first)) {
                        $tid = (int) $first;
                    }
                }
            }

            if (is_int($tid) && $tid > 0) {
				$args = [$tid];

				// create Knowledge Base by Task
				$view = \Drupal\views\Views::getView('knowledge_taxonomy');
				if (!$view) {
					// If the knowledge base view isn't installed, don't fatal the form.
					// Just leave the element markup as-is.
					return;
				}
				$view->setArguments($args);
				$view->setDisplay('block_1');
				$view->preExecute();
				$view->execute();
				$content = $view->buildRenderable('block_1', $args);

				// Add exceptions array and hidden spans of content
				$query = \Drupal::database()->select('node__field_exception', 'e');
				$query->join('node__field_parent_tile', 'p', 'p.entity_id = e.entity_id');
				$query->join('node__field_exception_text', 't', 't.entity_id = e.entity_id');
				$query->addField('e', 'entity_id');
				$query->addField('t', 'field_exception_text_value');
				$query->condition('e.field_exception_value', 1);
				$query->condition('p.field_parent_tile_target_id', $tid);
				$results = $query->execute()->fetchAll(\PDO::FETCH_OBJ);
				$exceptions = '';
				$output = '';
				foreach ($results as $row) {
					$exceptions .= $row->entity_id . ',';
					$output .= '<div id="exception_'.$row->entity_id.'">';
					$output .= '<div class="exception-content"><h2>We\'re Sorry</h2>' . $row->field_exception_text_value . '</div>';
					$output .= '<div class="button-wrap"><a href="/" class="button" name="return_home">Return Home</a>';
					$output .= '<a class="button" name="okay">OK</a></div>';
					$output .= '</div>';
				}
				$exceptions = '<span id="aException">'. $exceptions .'</span>';
				// $element['#markup'] = drupal_render($content) .
				$element['#markup'] = \Drupal::service('renderer')->render($content) .
					 '<div class="hiddenException">' . $exceptions . $output . '</div>';
            }
        }
    }
}

function ucb_tma_interface_webform_submission_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
	// Ensure the FixIt UI behavior JS is attached even if a webform handler is misconfigured.
	// This is needed for exception popups and location dropdown UX.
	try {
		$webform_id = $form['#webform_id'] ?? NULL;
		if ($webform_id === 'report_a_problem' || $webform_id === 'request_services') {
			$form['#attached']['library'][] = 'ucb_tma_interface/report';
		}
	}
	catch (\Throwable) {
		// Ignore.
	}
}

